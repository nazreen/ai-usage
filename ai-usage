#!/usr/bin/env python3
"""Print remaining Claude Code and Codex plan usage, one line per tool.

Uses the same endpoints as CodexBar / claude-monitor style tools:
- Claude: GET api.anthropic.com/api/oauth/usage (token from macOS keychain)
- Codex:  GET chatgpt.com/backend-api/wham/usage (token from ~/.codex/auth.json)

--agent prints JSON for agents choosing a harness: it recommends the one
whose weekly usage is furthest behind the time elapsed in its week.
"""
import json, os, subprocess, sys, time, urllib.request
from datetime import datetime, timezone

BAR = 10
WEEK = 7 * 86400
# Below this much 5-hour quota left, Claude Code is not recommended.
MIN_5H_LEFT = 10.0
# Reuse API responses this many seconds, so repeated runs don't hit rate limits.
CACHE_TTL = 60
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "ai-usage")


def get(url, headers, name):
    path = os.path.join(CACHE_DIR, f"{name}.json")
    try:
        if time.time() - os.path.getmtime(path) < CACHE_TTL:
            with open(path) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    req = urllib.request.Request(url, headers={"User-Agent": "ai-usage", **headers})
    with urllib.request.urlopen(req, timeout=15) as r:
        d = json.load(r)
    try:
        os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(d, f)
    except OSError:
        pass
    return d


def window(used_pct, reset, window_secs):
    """Normalise one limit window into a dict."""
    used = max(0.0, min(100.0, float(used_pct or 0)))
    w = {"used_pct": round(used, 1), "left_pct": round(100 - used, 1),
         "resets_at": reset.isoformat() if reset else None,
         "_reset": reset, "_secs": window_secs}
    if reset:
        remaining = max(0.0, (reset - datetime.now(timezone.utc)).total_seconds())
        w["resets_in_hours"] = round(remaining / 3600, 1)
        elapsed = max(0.0, min(100.0, (1 - remaining / window_secs) * 100))
        w["elapsed_pct"] = round(elapsed, 1)
        # Negative = used less than an even pace would by now.
        w["pace_delta_pct"] = round(used - elapsed, 1)
    return w


def claude():
    # Several items can share this service name (e.g. acct "unknown" holding only
    # mcpOAuth); prefer the one Claude Code writes under the login user.
    token = None
    for acct in (["-a", os.environ.get("USER", "")], []):
        r = subprocess.run(
            ["security", "find-generic-password", "-s", "Claude Code-credentials", *acct, "-w"],
            capture_output=True, text=True)
        if r.returncode == 0:
            token = json.loads(r.stdout).get("claudeAiOauth", {}).get("accessToken")
            if token:
                break
    if not token:
        raise RuntimeError("no claude.ai login in keychain; run /login in claude")
    d = get("https://api.anthropic.com/api/oauth/usage",
            {"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"}, "claude-code")
    out = {}
    for key, name, secs in (("seven_day", "weekly", WEEK), ("five_hour", "five_hour", 5 * 3600)):
        w = d.get(key)
        if w:
            r = w.get("resets_at")
            out[name] = window(w.get("utilization"),
                               datetime.fromisoformat(r.replace("Z", "+00:00")) if r else None, secs)
    return out


def codex():
    auth = json.load(open(os.path.expanduser("~/.codex/auth.json")))
    t = auth["tokens"]
    h = {"Authorization": f"Bearer {t['access_token']}"}
    if t.get("account_id"):
        h["ChatGPT-Account-Id"] = t["account_id"]
    d = get("https://chatgpt.com/backend-api/wham/usage", h, "codex")
    rl = d.get("rate_limit") or {}
    wins = [w for w in (rl.get("primary_window"), rl.get("secondary_window")) if w]
    out = {}
    # Weekly = window of ~7 days; ignore shorter windows per plan.
    for w in wins:
        secs = w.get("limit_window_seconds") or WEEK
        if secs >= 6 * 86400 or len(wins) == 1:
            r = w.get("reset_at")
            out["weekly"] = window(w.get("used_percent"),
                                   datetime.fromtimestamp(r, timezone.utc) if r else None, secs)
    return out


def until(dt):
    if not dt:
        return "?"
    s = max(int((dt - datetime.now(timezone.utc)).total_seconds()), 0)
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return f"{d}d {h}h" if d else f"{h}h {m}m"


# Colour only on a terminal, and never when NO_COLOR is set (no-color.org).
COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ


def rgb(hex_):
    r, g, b = (int(hex_[i:i + 2], 16) for i in (1, 3, 5))
    return f"\033[38;2;{r};{g};{b}m"


LABEL, DIM, EMPTY, MARK, BOLD, OK = rgb("#bb9af7"), rgb("#565f89"), rgb("#3b4261"), \
    "\033[1;97m", "\033[1m", "\033[1;38;2;158;206;106m"
TOOL_COLOR = {"claude-code": rgb("#ff9e64"), "codex": rgb("#2ac3de")}


def c(code, text):
    return f"{code}{text}\033[0m" if COLOR else text


def seg(label, w, marker, used_color):
    n = round(w["used_pct"] / 100 * BAR)
    cells = [c(used_color, '█')] * n + [c(EMPTY, '░')] * (BAR - n)
    # Mark how far through the window we are now.
    if marker and "elapsed_pct" in w:
        i = round(w["elapsed_pct"] / 100 * BAR)
        cells.insert(i, c(MARK, '│'))
    pct = c(BOLD, "%3.0f%%" % w["left_pct"])
    reset = c(DIM, "(%s)" % until(w["_reset"]))
    return f"{c(DIM, label)} [{''.join(cells)}] {pct} left {reset}"


def recommend(data):
    """Return (harness, reason, unavailable) where unavailable lists harnesses with no data."""
    candidates, unavailable, skipped = [], [], []
    for name, d in data.items():
        wk = d.get("weekly")
        if "error" in d or not wk or "pace_delta_pct" not in wk:
            unavailable.append(name)
            continue
        fh = d.get("five_hour")
        if wk["left_pct"] <= 0 or (fh and fh["left_pct"] < MIN_5H_LEFT):
            skipped.append(name)
            continue
        candidates.append((wk["pace_delta_pct"], name))
    notes = [f"{n} skipped: no usage data" for n in unavailable]
    notes += [f"{n} skipped: quota nearly used up" for n in skipped]
    if not candidates:
        return None, "; ".join(notes or ["no harness has usable quota data"]), unavailable
    candidates.sort()
    delta, name = candidates[0]
    reason = f"{name} weekly usage is {abs(delta)} pts {'behind' if delta < 0 else 'ahead of'} week elapsed"
    if len(candidates) > 1:
        reason += f"; {candidates[1][1]} is {candidates[1][0]:+} pts"
    return name, "; ".join([reason] + notes), unavailable


def strip(d):
    return {k: ({kk: vv for kk, vv in v.items() if not kk.startswith("_")}
                if isinstance(v, dict) else v) for k, v in d.items()}


data = {}
for name, fn in (("claude-code", claude), ("codex", codex)):
    try:
        data[name] = fn()
    except Exception as e:
        data[name] = {"error": str(e)}

if "--agent" in sys.argv[1:]:
    rec, reason, unavailable = recommend(data)
    print(json.dumps({
        "recommended_harness": rec,
        "reason": reason,
        "unavailable_harnesses": unavailable,
        "rule": "prefer the harness with the lowest weekly pace_delta_pct (used_pct - elapsed_pct); "
                f"skip any with 0% weekly left or under {MIN_5H_LEFT:.0f}% five_hour left",
        "harnesses": {k: strip(v) for k, v in data.items()},
    }, indent=2))
else:
    for name, label in (("claude-code", "Claude Code"), ("codex", "Codex")):
        d = data[name]
        if "error" in d:
            print(f"{c(LABEL, f'{label:<12}')}error: {d['error']}")
            continue
        parts = [seg("wk", d["weekly"], True, TOOL_COLOR[name])] if "weekly" in d else []
        if "five_hour" in d:
            parts.append(seg("5h", d["five_hour"], False, TOOL_COLOR[name]))
        print(c(LABEL, f"{label:<12}") + "   ".join(parts))
    rec, reason, _ = recommend(data)
    print(c(LABEL, f"{'Use':<12}") + c(OK, rec or "none") + " " + c(DIM, f"({reason})"))
